# Defaults for the SEM Simulator <-> OpenCode integration.
# Values already present in the environment win over these defaults.
# Authentication is optional. The password lives in .opencode/password (mode
# 600). An empty or missing file starts the server without authentication.
# OPENCODE_PASSWORD and OPENCODE_SERVER_PASSWORD are both supported by the
# OpenCode CLI; the scripts keep them in sync.
: "${OPENCODE_URL:=http://127.0.0.1:4096}"
: "${OPENCODE_HOSTNAME:=0.0.0.0}"
: "${OPENCODE_PORT:=4096}"
: "${OPENCODE_PASSWORD_FILE:=.opencode/password}"
: "${OPENCODE_AGENT:=build}"
# Set OPENCODE_MODEL to a tool-capable model if the server default is not one.
# : "${OPENCODE_MODEL:=opencode/deepseek-v4.1-flash-free}"
: "${SEM_CONTROL_URL:=http://127.0.0.1:47831}"
